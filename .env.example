BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789

# Общий почтовый ящик, с которого бот читает письма с кодами (IMAP)
IMAP_EMAIL=you@yandex.ru
IMAP_PASSWORD=app_password_here

DB_PATH=bot.db
SPAM_LIMIT=3
CODE_TIMEOUT=180
SPAM_WINDOW=1800

# Прокси до Telegram Bot API. Нужен, если сервер бота в РФ (или в другой
# стране, где Bot API нестабилен/заблокирован). Оставь пустым, если сервер
# за рубежом и доступ к api.telegram.org прямой.
# Формат: socks5://host:port  или  socks5://user:pass@host:port
TELEGRAM_PROXY=

# GGsel / Digiseller Seller API -- для проверки номера заказа перед выдачей кода.
# id продавца: https://my.digiseller.com/inside/my_info.asp
# api-ключ:    https://my.digiseller.com/inside/api_keys.asp
GGSEL_SELLER_ID=
GGSEL_API_KEY=
